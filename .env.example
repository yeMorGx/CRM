NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APIFY_API_TOKEN=your-apify-api-token
GOOGLE_PLACES_API_KEY=your-server-only-google-places-api-key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Prospecta <no-reply@your-verified-domain.com>

# Gerenciamento de usuários: somente servidor, nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CRM_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# WhatsApp Business Platform / Cloud API. Configure no servidor da Vercel; nunca use NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=generate-a-private-webhook-verification-token
WHATSAPP_API_VERSION=vXX.0
WHATSAPP_FIRST_CONTACT_TEMPLATE_NAME=approved_template_name
WHATSAPP_FIRST_CONTACT_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_FIRST_CONTACT_TEMPLATE_PREVIEW=Exact approved template text shown to the sender

# OAuth de calendários. Registre os callbacks exibidos em Configurações → Calendários integrados.
APP_BASE_URL=https://seu-dominio-de-producao.com
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-server-only-google-oauth-client-secret
MICROSOFT_CALENDAR_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=your-server-only-microsoft-client-secret
MICROSOFT_CALENDAR_TENANT_ID=common
NOTION_CALENDAR_CLIENT_ID=your-notion-public-connection-client-id
NOTION_CALENDAR_CLIENT_SECRET=your-server-only-notion-client-secret
OAUTH_TOKEN_ENCRYPTION_KEY=generate-a-private-32-byte-base64-key

# Web Push: gerar um par VAPID uma única vez no servidor; nunca expor a chave privada.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
