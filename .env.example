NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APIFY_API_TOKEN=your-apify-api-token
GOOGLE_PLACES_API_KEY=your-server-only-google-places-api-key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Prospecta <no-reply@your-verified-domain.com>

# Gerenciamento de usuários: somente servidor, nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CRM_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# WhatsApp Business Platform / Cloud API. Configure no servidor da Vercel; nunca use NEXT_PUBLIC_.
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=generate-a-private-webhook-verification-token
WHATSAPP_API_VERSION=vXX.0
WHATSAPP_FIRST_CONTACT_TEMPLATE_NAME=approved_template_name
WHATSAPP_FIRST_CONTACT_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_FIRST_CONTACT_TEMPLATE_PREVIEW=Exact approved template text shown to the sender
